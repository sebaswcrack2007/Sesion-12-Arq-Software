# Manifiesto Kubernetes: PriorityClass y QoS "Guaranteed" para alertas críticas UCI
apiVersion: scheduling.k8s.io/v1
kind: PriorityClass
metadata:
  name: uci-critica
value: 1000000
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: alertas-uci
spec:
  template:
    spec:
      priorityClassName: uci-critica
      containers:
        - name: alertas-uci
          image: hospitvalle/alertas-uci:1.0
          resources:
            requests:
              cpu: "2"
              memory: "1Gi"
            limits:
              cpu: "2"          # Genera cgroup cpu.max = "200000 100000" (2.0 vCPU fijas)
              memory: "1Gi"
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: telemetria-regular
spec:
  template:
    spec:
      containers:
        - name: telemetria-regular
          image: hospitvalle/telemetria:1.0
          resources:
            requests:
              cpu: "500m"
              memory: "512Mi"
            limits:
              cpu: "1500m"      # Genera cgroup cpu.max = "150000 100000" (1.5 vCPU máx)
              memory: "1Gi"